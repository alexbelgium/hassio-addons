#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

# HTTP proxy for other add-ons (Sonarr, Radarr, Prowlarr...) whose outgoing
# connections are bound to the VPN address, so the VPN policy routing sends
# them through the tunnel. It only runs while the VPN address and its routing
# rule exist; otherwise it stops and s6 restarts this script, which waits.

VPN_PROXY_PORT=8118
CONF=/etc/tinyproxy-vpn.conf

if bashio::config.true 'openvpn_enabled'; then
    VPN_INTERFACE="$(cat /var/run/openvpn/interface 2> /dev/null || true)"
else
    VPN_INTERFACE="$(cat /var/run/wireguard/interface 2> /dev/null || true)"
fi

vpn_ip() {
    ip -4 -o addr show dev "${VPN_INTERFACE:-none}" 2> /dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1 || true
}

# The VPN is up when its address exists, the rule routing that address through
# the tunnel is in place, and resolv.conf points to the VPN DNS (written last by sbin/vpn)
vpn_up() {
    [[ -n "$1" ]] && [[ "$(vpn_ip)" == "$1" ]] \
        && ip -4 rule show 2> /dev/null | grep -qFw "from $1" \
        && grep -q '^# Generated by vpn script' /etc/resolv.conf 2> /dev/null
}

VPN_IP="$(vpn_ip)"
if ! vpn_up "${VPN_IP}"; then
    bashio::log.error "VPN proxy NOT started: the VPN is not up (interface '${VPN_INTERFACE:-unknown}' has no VPN address or routing). Requests to port ${VPN_PROXY_PORT} are refused. Check the OpenVPN/WireGuard messages above. Retrying in 30 s..."
    sleep 30
    exit 1
fi

cat > "${CONF}" << CONFEOF
Port ${VPN_PROXY_PORT}
Bind ${VPN_IP}
Timeout 600
LogLevel Notice
# Clients: this container and the Home Assistant add-on network only, never the VPN side
Allow 127.0.0.1
Allow 172.30.32.0/23
CONFEOF

bashio::log.info "Starting VPN proxy on port ${VPN_PROXY_PORT}: outgoing traffic leaves through ${VPN_INTERFACE} (${VPN_IP})."
s6-setuidgid abc tinyproxy -d -c "${CONF}" &
PROXY_PID=$!
trap 'kill "${PROXY_PID}" 2> /dev/null || true; exit 0' TERM INT

# Stop the proxy as soon as the VPN goes down or reconnects with another address
while kill -0 "${PROXY_PID}" 2> /dev/null; do
    if ! vpn_up "${VPN_IP}"; then
        bashio::log.error "VPN proxy STOPPED: the VPN went down or changed address. Requests to port ${VPN_PROXY_PORT} are refused until it is back."
        kill "${PROXY_PID}" 2> /dev/null || true
        exit 1
    fi
    sleep 5 & wait $!
done

# Also reached when the OpenVPN down hook stops tinyproxy (sbin/vpn)
bashio::log.error "VPN proxy STOPPED: tinyproxy exited (VPN going down?). Restarting once the VPN is up."
exit 1
