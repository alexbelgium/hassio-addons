#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -e

hindsight_ready=false
deadline=$((SECONDS + 900))
while [ "$SECONDS" -lt "$deadline" ]; do
    if curl -sf --connect-timeout 2 --max-time 5 -o /dev/null "http://127.0.0.1:9998/" || curl -sf --connect-timeout 2 --max-time 5 -o /dev/null "http://127.0.0.1:8888/health"; then
        hindsight_ready=true
        break
    fi
    sleep 2
done

if [ "$hindsight_ready" != true ]; then
    bashio::log.warning "Hindsight did not answer within 15 minutes. Starting NGinx anyway: ingress will return 502 until it does."
fi

bashio::log.info "Starting NGinx..."
exec nginx
