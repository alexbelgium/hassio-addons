#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -e

omniroute_ready=false
deadline=$((SECONDS + 900))
while [ "$SECONDS" -lt "$deadline" ]; do
    if curl -sf --connect-timeout 2 --max-time 5 -o /dev/null "http://127.0.0.1:20129/"; then
        omniroute_ready=true
        break
    elif curl -sf --connect-timeout 2 --max-time 5 -o /dev/null "http://127.0.0.1:20129/api/monitoring/health"; then
        omniroute_ready=true
        break
    fi
    sleep 2
done

if [ "$omniroute_ready" != true ]; then
    bashio::log.warning "OmniRoute did not answer within 15 minutes. Starting NGinx anyway: ingress will return 502 until it does."
fi

bashio::log.info "Starting NGinx..."
exec nginx
